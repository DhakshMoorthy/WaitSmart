# Supabase project settings: server-side only, do not expose with NEXT_PUBLIC_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects /admin/leads and the internal login session. Use a long random value.
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Resend transactional email. Configure a verified sender domain first.
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Klinicals <notifications@your-verified-domain.com>
