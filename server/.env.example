# WaitSmart Backend Environment Variables
# Copy to .env and fill in values.
# For Render deployment, these are auto-configured via render.yaml blueprint.

NODE_ENV=development
PORT=4000

# PostgreSQL (local Docker OR Render-managed)
DATABASE_URL=postgresql://waitsmart:waitsmart@localhost:5432/waitsmart

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Seed superadmin (required in production; dev defaults to superadmin@waitsmart.app / Admin@1234)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks > secret (NOT the key secret). Webhooks are rejected without it.
RAZORPAY_WEBHOOK_SECRET=

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@waitsmart.app

# SMS (MSG91 / Twilio)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
# msg91: SMS_API_KEY = authkey, SMS_TEMPLATE_ID = DLT-approved OTP template
# twilio: TWILIO_ACCOUNT_SID + SMS_API_KEY (auth token) + SMS_SENDER_ID (from number)
SMS_TEMPLATE_ID=
# DEVELOPMENT ONLY: return the OTP in the API response / show it in the UI instead of sending an SMS
EXPOSE_DEV_OTP=false
TWILIO_ACCOUNT_SID=
# Clinic new phone-login patients join when the client does not name one
DEFAULT_TENANT_SLUG=apollo-clinic
# DEVELOPMENT: seed demo bookings + test accounts (docs/TEST_DATA.md). Staff logins also need TEST_ACCOUNTS_PASSWORD (8+ chars).
SEED_TEST_DATA=false
TEST_ACCOUNTS_PASSWORD=

# Object storage (Oracle OCI / S3)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# CORS
# Exact origins only (no wildcards)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
