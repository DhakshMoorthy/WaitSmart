{
  "name": "waitsmart-queue-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --open",
    "prebuild": "pnpm --filter @waitsmart/shared build",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 5173",
    "start": "vite --port 5173 --open",
    "serve": "pnpm build && npx --yes serve dist -s -l 8080"
  },
  "dependencies": {
    "@waitsmart/shared": "workspace:*",
    "dayjs": "^1.11.10",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
