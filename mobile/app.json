{
  "expo": {
    "name": "WaitSmart",
    "slug": "waitsmart",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "waitsmart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.waitsmart.mobile"
    },
    "android": {
      "package": "app.waitsmart.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
